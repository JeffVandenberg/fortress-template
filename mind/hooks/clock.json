{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '[clock: %s]\\n' \"$(date '+%a %b %-d %-I:%M %p %Z')\" 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "printf '{\"hookSpecificOutput\":{\"hookEventName\":\"PostToolUse\",\"additionalContext\":\"[clock: %s]\"}}\\n' \"$(date '+%a %b %-d %-I:%M %p %Z')\" 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
